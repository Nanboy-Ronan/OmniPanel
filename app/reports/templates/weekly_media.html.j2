      {% else %}
      {% set tw = am.this_week %}
      {% set lw = am.last_week if am.comparable else none %}
      {% if not tw.complete %}
      <div class="caveat-box">⚠️ 本周数据概览仅有 {{ tw.days_present }}/{{ tw.days_expected }} 天（缺 {% for d in tw.missing_dates %}{{ d | fmt_date }}{% if not loop.last %}、{% endif %}{% endfor %}），以下为已有天数合计，不作周环比。</div>
      {% elif not am.comparable %}
      <div class="caveat-box">ℹ️ 上周数据概览不完整（{{ am.last_week.days_present }}/{{ am.last_week.days_expected }} 天），本周不作环比。</div>
      {% endif %}
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">账号观看量</div>
          <div class="kpi-value">{{ tw.totals.view_count | fmt_int }}</div>
          {{ render_delta(tw.totals.view_count, lw.totals.view_count if lw else none) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">主页访问</div>
          <div class="kpi-value">{{ tw.totals.home_view_count | fmt_int }}</div>
          {{ render_delta(tw.totals.home_view_count, lw.totals.home_view_count if lw else none) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">互动（赞/藏/评/分享）</div>
          <div class="kpi-value">{{ tw.totals.interactions | fmt_int }}</div>
          {{ render_delta(tw.totals.interactions, lw.totals.interactions if lw else none) }}
