              <td class="title">{{ top_n.title }}</td>
              <td>{{ top_n.publish_date | fmt_date }}</td>
              <td class="num"><span class="badge badge-xhs">+{{ top_n.new_followers | fmt_int }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      <h4 style="margin: 24px 0 8px; color: var(--text-muted);">本周新发布笔记单篇数据</h4>
      {% if section.this_week_posts %}
      <div class="table-wrapper">
