<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>周报 {{ context.bounds.this_week_start }} ~ {{ context.bounds.this_week_end }}</title>
<!-- Load Chart.js CDN for modern interactive graphs -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
  :root {
    --bg-page: #f8fafc;
    --bg-surface: #ffffff;
    --bg-subtle: #f1f5f9;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --text-sub: #94a3b8;
    --border-color: #e2e8f0;
    --border-subtle: #f1f5f9;

    /* Brand Accents */
    --brand-wechat: #07c160;
    --brand-wechat-bg: #f0fdf4;
    --brand-xhs: #ff2442;
    --brand-xhs-bg: #fff1f2;
    --brand-channels: #f59e0b;
    --brand-channels-bg: #fffbe6;
    --brand-zhihu: #0084ff;
    --brand-zhihu-bg: #eff6ff;
    --brand-pgy: #ec4899;
    --brand-pgy-bg: #fdf2f8;
    --brand-ecom: #10b981;
    --brand-ecom-bg: #ecfdf5;

    /* Indicator Status */
    --status-good: #10b981;
    --status-good-bg: #d1fae5;
    --status-bad: #ef4444;
    --status-bad-bg: #fee2e2;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background-color: var(--bg-page);
    color: var(--text-main);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 20px 80px;
  }

  /* Header Banner */
  .hero-header {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    border-radius: 20px;
    padding: 32px;
    margin-bottom: 24px;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.15);
    position: relative;
    overflow: hidden;
  }
  .hero-header::after {
    content: "";
    position: absolute;
    top: -50%; right: -10%;
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, rgba(255,255,255,0) 70%);
    pointer-events: none;
  }
  .hero-header h1 {
    font-size: 26px;
    font-weight: 800;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-header .badge-date {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    font-size: 13px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 99px;
  }
  .hero-header .meta-info {
    color: #94a3b8;
    font-size: 13.5px;
    display: flex;
    gap: 16px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  /* Sticky Navigation Bar (Panel Switcher) */
  .nav-bar {
    position: sticky;
    top: 12px;
    z-index: 100;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 6px;
    margin-bottom: 28px;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.06);
    display: flex;
    gap: 6px;
    overflow-x: auto;
  }
  .nav-tab {
    background: transparent;
    border: none;
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-tab:hover {
    background: var(--bg-subtle);
    color: var(--text-main);
  }
  .nav-tab.active {
    background: var(--text-main);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
  }
  .nav-tab .pill-count {
    font-size: 11px;
    background: rgba(148, 163, 184, 0.2);
    padding: 1px 6px;
    border-radius: 99px;
  }
  .nav-tab.active .pill-count {
    background: rgba(255, 255, 255, 0.25);
  }

  /* AI Insight Box */
  .ai-panel {
    background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
    border: 1px solid #bfdbfe;
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 28px;
    position: relative;
  }
  .ai-panel-title {
    font-size: 14px;
    font-weight: 700;
    color: #1d4ed8;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .ai-panel-content {
    font-size: 14.5px;
    color: #1e293b;
    line-height: 1.65;
    white-space: pre-wrap;
  }

  /* Visual Chart Grid */
  .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }
  .chart-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 20px 24px;
    box-shadow: 0 2px 10px -2px rgba(15, 23, 42, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .chart-card:hover {
    box-shadow: 0 8px 25px -4px rgba(15, 23, 42, 0.08);
  }
  .chart-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .chart-container {
    position: relative;
    height: 260px;
    width: 100%;
  }

  /* Platform Panels & Cards */
  .platform-panel {
    margin-bottom: 40px;
    scroll-margin-top: 80px;
  }
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--border-color);
  }
  .panel-title {
    font-size: 20px;
    font-weight: 750;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
  }
  .panel-title-badge {
    width: 10px;
    height: 22px;
    border-radius: 4px;
  }

  /* Card */
  .card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: 0 2px 10px -2px rgba(15, 23, 42, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    box-shadow: 0 8px 25px -4px rgba(15, 23, 42, 0.08);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .card-header h3 {
    font-size: 17px;
    font-weight: 700;
    margin: 0;
    color: var(--text-main);
  }

  /* KPI Grid */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  .kpi-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .kpi-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .kpi-value {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .kpi-delta {
    font-size: 11.5px;
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--text-muted);
  }
  .arrow-up {
    color: var(--status-good);
    font-weight: 700;
    background: var(--status-good-bg);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .arrow-down {
    color: var(--status-bad);
    font-weight: 700;
    background: var(--status-bad-bg);
    padding: 1px 5px;
    border-radius: 4px;
  }

  /* Tables */
  .table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    margin-top: 12px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  th {
    background: #f8fafc;
    color: var(--text-muted);
    font-weight: 650;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
  }
  td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-main);
    white-space: nowrap;
  }
  tr:last-child td {
    border-bottom: none;
  }
  tr:hover td {
    background-color: #f1f5f9;
  }
  td.title {
    white-space: normal;
    max-width: 380px;
    font-weight: 500;
  }
  td.num, th.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  /* Progress Bar List for Traffic Sources */
  .source-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
  }
  .source-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }
  .source-name {
    width: 110px;
    font-weight: 500;
    color: var(--text-main);
  }
  .source-bar-bg {
    flex: 1;
    height: 8px;
    background: #e2e8f0;
    border-radius: 99px;
    overflow: hidden;
  }
  .source-bar-fill {
    height: 100%;
    border-radius: 99px;
  }
  .source-pct {
    width: 50px;
    text-align: right;
    font-weight: 650;
    color: var(--text-muted);
  }

  /* Badges & Tags */
  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 99px;
  }
  .badge-wechat { background: var(--brand-wechat-bg); color: var(--brand-wechat); }
  .badge-xhs { background: var(--brand-xhs-bg); color: var(--brand-xhs); }
  .badge-channels { background: var(--brand-channels-bg); color: #d97706; }
  .badge-zhihu { background: var(--brand-zhihu-bg); color: var(--brand-zhihu); }
  .badge-pgy { background: var(--brand-pgy-bg); color: var(--brand-pgy); }
  .badge-ecom { background: var(--brand-ecom-bg); color: var(--brand-ecom); }

  /* Rank Icons */
  .rank-pill {
    width: 22px; height: 22px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; font-size: 12px; font-weight: 700;
  }
  .rank-1 { background: #fef3c7; color: #d97706; }
  .rank-2 { background: #f1f5f9; color: #64748b; }
  .rank-3 { background: #ffedd5; color: #c2410c; }

  .caveat-box {
    font-size: 12.5px;
    color: var(--text-muted);
    background: var(--bg-subtle);
    border-radius: 8px;
    padding: 10px 14px;
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .empty-state {
    text-align: center;
    padding: 32px 16px;
    color: var(--text-muted);
    font-size: 14px;
  }

  footer {
    text-align: center;
    padding: 40px 0 20px;
    color: var(--text-sub);
    font-size: 13px;
    border-top: 1px solid var(--border-color);
  }
</style>
</head>
<body>

<div class="container">
  <!-- Header -->
  <div class="hero-header">
    <h1>
      📊 自媒体与商城全平台周报
      <span class="badge-date">{{ context.bounds.this_week_start }} ~ {{ context.bounds.this_week_end }}</span>
    </h1>
    <div class="meta-info">
      <span>生成时间：{{ context.generated_at | fmt_datetime }}</span>
      <span>|</span>
      <span>已聚合：微信公众号 · 小红书 · 视频号 · 知乎 · 蒲公英 · 商城</span>
    </div>
  </div>

  <!-- Sticky Navigation Panel Selector -->
  <nav class="nav-bar">
    <button class="nav-tab active" onclick="switchPanel('all', this)">
      🌐 全平台总览
    </button>
    {% if context.wechat_sections %}
    <button class="nav-tab" onclick="switchPanel('wechat', this)">
      💬 公众号 <span class="pill-count">{{ context.wechat_sections | length }}</span>
    </button>
    {% endif %}
    {% if context.xhs_sections %}
    <button class="nav-tab" onclick="switchPanel('xhs', this)">
      📕 小红书 <span class="pill-count">{{ context.xhs_sections | length }}</span>
    </button>
    {% endif %}
    {% if context.channels_sections %}
    <button class="nav-tab" onclick="switchPanel('channels', this)">
      ▶️ 视频号 <span class="pill-count">{{ context.channels_sections | length }}</span>
    </button>
    {% endif %}
    {% if context.zhihu_section %}
    <button class="nav-tab" onclick="switchPanel('zhihu', this)">
      💡 知乎
    </button>
    {% endif %}
    {% if context.pgy_sections %}
    <button class="nav-tab" onclick="switchPanel('pgy', this)">
      🌼 蒲公英 <span class="pill-count">{{ context.pgy_sections | length }}</span>
    </button>
    {% endif %}
    {% if context.ecommerce_section %}
    <button class="nav-tab" onclick="switchPanel('ecommerce', this)">
      🛒 商城 (有赞/京东/天猫)
    </button>
    {% endif %}
  </nav>

  <!-- AI Executive Summary Panel -->
  {% if narrative %}
  <div class="ai-panel">
    <div class="ai-panel-title">
      ✨ AI 智能业务解读
    </div>
    <div class="ai-panel-content">{{ narrative }}</div>
  </div>
  {% else %}
  <!--WORKBUDDY_NARRATIVE-->
  {% endif %}

  <!-- VISUAL CHARTS SECTION (NEW) -->
  <div class="chart-grid">
    <div class="chart-card">
      <div class="chart-title">📈 自媒体全平台阅读/播放量 (本周 vs 上周)</div>
      <div class="chart-container">
        <canvas id="chartPlatformCompare"></canvas>
      </div>
    </div>

    {% if context.ecommerce_section and context.ecommerce_section.platforms %}
    <div class="chart-card">
      <div class="chart-title">🛒 商城各渠道销售额 (GMV) 占比</div>
      <div class="chart-container">
        <canvas id="chartEcomDonut"></canvas>
      </div>
    </div>
    {% endif %}
  </div>

  <!-- Delta Macro -->
  {% macro render_delta(this_v, last_v, is_num=false, prefix='') %}
  {% if this_v is not none and last_v is not none %}
  {% set diff = this_v - last_v %}
  <div class="kpi-delta">
    {% if diff > 0 %}
      <span class="arrow-up">▲ {{ prefix }}{{ diff | fmt_num if is_num else diff | fmt_int }}</span>
    {% elif diff < 0 %}
      <span class="arrow-down">▼ {{ prefix }}{{ (-diff) | fmt_num if is_num else (-diff) | fmt_int }}</span>
    {% else %}
      <span class="dim">持平</span>
    {% endif %}
    <span class="dim">· 上周 {{ prefix }}{{ last_v | fmt_num if is_num else last_v | fmt_int }}</span>
  </div>
  {% elif last_v is not none %}
  <div class="kpi-delta">
    <span class="dim">· 上周 {{ prefix }}{{ last_v | fmt_num if is_num else last_v | fmt_int }}</span>
  </div>
  {% endif %}
  {% endmacro %}

  {# Cumulative totals of different post cohorts: show last week's figure
     for reference without a ▲/▼ that would read as a week-over-week change. #}
  {% macro render_cohort_ref(last_v) %}
  {% if last_v is not none %}
  <div class="kpi-delta">
    <span class="dim">· 上周新发内容累计 {{ last_v | fmt_int }}（非同龄对比）</span>
  </div>
  {% endif %}
  {% endmacro %}


  <!-- PANEL 1: 微信公众号 -->
  {% if context.wechat_sections %}
  <section class="platform-panel" id="panel-wechat">
    <div class="panel-header">
      <h2 class="panel-title">
        <span class="panel-title-badge" style="background: var(--brand-wechat)"></span>
        微信公众号
      </h2>
      <span class="badge badge-wechat">微信官方数据源</span>
    </div>

    {% for section in context.wechat_sections %}
    {% set totals_this = section.totals_this_week %}
    {% set totals_last = section.totals_last_week %}
    <div class="card">
      <div class="card-header">
        <h3>{{ section.account.name }}</h3>
        {% if section.last_sync_at %}<span class="dim" style="font-size:12px;">最后同步：{{ section.last_sync_at | fmt_date }}</span>{% endif %}
      </div>

      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">阅读人数</div>
          <div class="kpi-value">{{ totals_this.read_user_count | fmt_int }}</div>
          {{ render_delta(totals_this.read_user_count, totals_last.read_user_count) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">点赞</div>
          <div class="kpi-value">{{ totals_this.like_user | fmt_int }}</div>
          {{ render_delta(totals_this.like_user, totals_last.like_user) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">转发</div>
          <div class="kpi-value">{{ totals_this.share_user_count | fmt_int }}</div>
          {{ render_delta(totals_this.share_user_count, totals_last.share_user_count) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">评论</div>
          <div class="kpi-value">{{ totals_this.comment_count | fmt_int }}</div>
          {{ render_delta(totals_this.comment_count, totals_last.comment_count) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">收藏</div>
          <div class="kpi-value">{{ totals_this.collection_user | fmt_int }}</div>
          {{ render_delta(totals_this.collection_user, totals_last.collection_user) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">在看</div>
          <div class="kpi-value">{{ totals_this.zaikan_user | fmt_int }}</div>
          {{ render_delta(totals_this.zaikan_user, totals_last.zaikan_user) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">关注者阅读人数</div>
          <div class="kpi-value">{{ totals_this.read_subscribe_user | fmt_int }}</div>
          {{ render_delta(totals_this.read_subscribe_user, totals_last.read_subscribe_user) }}
        </div>
      </div>
      {% if section.read_sources %}
      <h4 style="margin: 16px 0 8px; color: var(--text-muted);">📥 本周阅读来源（各文章快照差合计）</h4>
      <div class="source-list">
        {% for src in section.read_sources[:8] %}
        <div class="source-item">
          <div class="source-name">{{ src.scene }}</div>
          <div class="source-bar-bg"><div class="source-bar-fill" style="width: {{ src.share_pct }}%; background: var(--brand-wechat);"></div></div>
          <div class="source-pct">{{ src.readers | fmt_int }} · {{ src.share_pct | fmt_pct100 }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      <!-- Follower stats if available -->
      {% if section.follower and section.follower.available %}
      {% set fw = section.follower %}
      <h4 style="margin: 16px 0 8px; color: var(--text-muted);">👥 粉丝动态与流失分析</h4>
      <div class="kpi-grid">
        <div class="kpi-card" style="background: #f0fdf4;">
          <div class="kpi-label" style="color:#166534;">本周新增关注</div>
          <div class="kpi-value" style="color:#15803d;">+{{ fw.this_week.new_user | fmt_int }}</div>
          <div class="kpi-delta"><span class="dim">上周 +{{ fw.last_week.new_user | fmt_int }}</span></div>
        </div>
        <div class="kpi-card" style="background: #fef2f2;">
          <div class="kpi-label" style="color:#991b1b;">本周取消关注</div>
          <div class="kpi-value" style="color:#dc2626;">-{{ fw.this_week.cancel_user | fmt_int }}</div>
          <div class="kpi-delta"><span class="dim">上周 -{{ fw.last_week.cancel_user | fmt_int }}</span></div>
        </div>
        <div class="kpi-card" style="background: #eff6ff;">
          <div class="kpi-label" style="color:#1e40af;">本周净增粉丝</div>
          <div class="kpi-value" style="color:#2563eb;">{{ fw.this_week.net_gain | fmt_int }}</div>
          <div class="kpi-delta"><span class="dim">上周 {{ fw.last_week.net_gain | fmt_int }}</span></div>
        </div>
      </div>
      {% endif %}

      <h4 style="margin: 16px 0 8px; color: var(--text-muted);">本周新发布文章明细 ({{ (section.this_week_articles if section.this_week_articles is not none else section.articles) | length }} 篇)</h4>
      {% set main_articles = section.this_week_articles if section.this_week_articles is not none else section.articles %}
      {% if main_articles %}
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>标题</th>
              <th>发布日期</th>
              <th class="num">阅读人数</th>
              <th class="num">关注者阅读</th>
              <th class="num">完读率</th>
