          <div class="kpi-value">{% if tw.avg_view_time is not none %}{{ tw.avg_view_time | fmt_num }}s{% else %}—{% endif %}</div>
          {{ render_delta(tw.avg_view_time, lw.avg_view_time if lw else none, true) }}
