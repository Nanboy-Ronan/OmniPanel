        {% for code, t in context.zhihu_section.this_week_summary.by_type.items() %}{{ t.label }} {{ t.count | fmt_int }} 篇 · 阅读 {{ t.reads | fmt_int }}{% if not loop.last %}　｜　{% endif %}{% endfor %}
      </div>

      <h4 style="margin: 16px 0 8px; color: var(--text-muted);">知乎内容明细</h4>
      {% if context.zhihu_section.this_week_posts %}
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>类型</th>
              <th>标题</th>
              <th>发布日期</th>
              <th class="num">阅读</th>
              <th class="num">点赞</th>
              <th class="num">评论</th>
              <th class="num">收藏</th>
              <th class="num">分享</th>
            </tr>
          </thead>
          <tbody>
            {% for p in context.zhihu_section.this_week_posts %}
            <tr>
              <td>
                <span class="badge badge-zhihu">
                  {{ '文章' if p.content_type == 'article' else ('问答' if p.content_type == 'qa' else p.content_type) }}
                </span>
              </td>
              <td class="title">{{ p.title }}</td>
              <td>{{ p.publish_date | fmt_date }}</td>
              <td class="num">{{ p.reads | fmt_int }}</td>
              <td class="num">{{ p.likes | fmt_int }}</td>
              <td class="num">{{ p.comments | fmt_int }}</td>
              <td class="num">{{ p.collects | fmt_int }}</td>
              <td class="num">{{ p.shares | fmt_int }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty-state">本周暂无知乎新发布内容。</div>
      {% endif %}

      <div class="caveat-box">ℹ️ 数据来自知乎创作者后台导出，指标为累计表现。</div>
    </div>
  </section>
  {% endif %}


  <!-- PANEL 5: 蒲公英 -->
  {% if context.pgy_sections %}
  <section class="platform-panel" id="panel-pgy">
    <div class="panel-header">
      <h2 class="panel-title">
        <span class="panel-title-badge" style="background: var(--brand-pgy)"></span>
        小红书蒲公英（博主合作）
      </h2>
      <span class="badge badge-pgy">蒲公英平台导出</span>
    </div>

    {% for section in context.pgy_sections %}
    {% set pt = section.this_week_summary %}
    {% set pl = section.last_week_summary %}
    <div class="card">
      <div class="card-header">
        <h3>{{ section.account.name }}</h3>
        {% if section.data_date %}<span class="dim" style="font-size:12px;">数据导出于 {{ section.data_date | fmt_date }}</span>{% endif %}
      </div>

      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">本周发布合作笔记</div>
          <div class="kpi-value">{{ pt.count | fmt_int }}</div>
          {{ render_delta(pt.count, pl.count) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">曝光量</div>
          <div class="kpi-value">{{ pt.total_impressions | fmt_int }}</div>
          {{ render_cohort_ref(pl.total_impressions) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">阅读量 / 阅读人数</div>
          <div class="kpi-value">{{ pt.total_reads | fmt_int }}{% if pt.total_read_uv is not none %} / {{ pt.total_read_uv | fmt_int }}{% endif %}</div>
          {{ render_cohort_ref(pl.total_reads) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">互动量</div>
          <div class="kpi-value">{{ pt.total_interactions | fmt_int }}</div>
          {{ render_cohort_ref(pl.total_interactions) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">关注增量</div>
          <div class="kpi-value">{{ pt.total_follows | fmt_int }}</div>
          {{ render_cohort_ref(pl.total_follows) }}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">合作花费（达人报价 + 服务费）</div>
          <div class="kpi-value">{% if pt.total_spend is not none %}¥{{ pt.total_spend | fmt_num }}{% else %}—{% endif %}</div>
          <div class="kpi-delta"><span class="dim">{% if pt.total_blogger_quote is not none %}报价 ¥{{ pt.total_blogger_quote | fmt_num }}{% endif %}{% if pt.total_service_fee is not none %} · 服务费 ¥{{ pt.total_service_fee | fmt_num }}{% endif %}{% if pt.missing_cost %} · {{ pt.missing_cost }} 篇缺费用{% endif %}</span></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">互动成本（CPE）</div>
          <div class="kpi-value">{% if pt.cpe is not none %}¥{{ pt.cpe | fmt_num }}{% else %}—{% endif %}</div>
          <div class="kpi-delta"><span class="dim">仅含费用完整的笔记{% if pt.avg_cost_per_read is not none %} · 平台阅读单价均值 ¥{{ pt.avg_cost_per_read | fmt_num }}{% endif %}</span></div>
        </div>
      </div>
      {% if pt.organic_impressions is not none or pt.paid_impressions is not none or pt.boosted_impressions is not none %}
      <div class="dim" style="margin-top:8px; font-size:12px; line-height:1.7;">
        流量构成（曝光 / 阅读）：自然 {{ pt.organic_impressions | fmt_int }} / {{ pt.organic_reads | fmt_int }} · 付费 {{ pt.paid_impressions | fmt_int }} / {{ pt.paid_reads | fmt_int }} · 加热 {{ pt.boosted_impressions | fmt_int }} / {{ pt.boosted_reads | fmt_int }}
      </div>
      {% endif %}

      <h4 style="margin: 16px 0 8px; color: var(--text-muted);">合作笔记明细</h4>
      {% if section.this_week_notes %}
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>笔记标题</th>
              <th>博主</th>
              <th>发布日期</th>
              <th class="num">曝光</th>
              <th class="num">阅读</th>
              <th class="num">互动</th>
              <th class="num">点赞</th>
              <th class="num">收藏</th>
              <th class="num">花费</th>
              <th class="num">阅读单价</th>
            </tr>
          </thead>
          <tbody>
            {% for n in section.this_week_notes %}
            <tr>
              <td class="title">{{ n.note_title }}</td>
              <td>{{ n.blogger_nickname or '—' }}</td>
              <td>{{ n.publish_date | fmt_date }}</td>
              <td class="num">{{ n.impressions | fmt_int }}</td>
              <td class="num">{{ n.reads | fmt_int }}</td>
              <td class="num">{{ n.interactions | fmt_int }}</td>
              <td class="num">{{ n.likes | fmt_int }}</td>
              <td class="num">{{ n.collects | fmt_int }}</td>
              <td class="num">{% if n.spend is not none %}¥{{ n.spend | fmt_num }}{% else %}—{% endif %}</td>
              <td class="num">{% if n.cost_per_read is not none %}¥{{ n.cost_per_read | fmt_num }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="empty-state">本周暂无合作笔记数据。</div>
      {% endif %}

      <div class="caveat-box">ℹ️ 数据来自蒲公英平台导出，按发布日期统计合作笔记截至导出时的累计表现。{{ section.wow_caveat }}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}


  <!-- PANEL 6: 商城 -->
  {% if context.ecommerce_section %}
  <section class="platform-panel" id="panel-ecommerce">
    <div class="panel-header">
      <h2 class="panel-title">
        <span class="panel-title-badge" style="background: var(--brand-ecom)"></span>
        电商商城 (有赞 + 京东 + 天猫)
      </h2>
      <span class="badge badge-ecom">多渠道订单导出</span>
    </div>

    {% set ecom_complete = context.ecommerce_section.complete is not defined or context.ecommerce_section.complete %}
    <div class="card">
      {% if not ecom_complete %}
      <div class="dim" style="margin-bottom: 12px; padding: 10px 12px; border-radius: 8px; background: #fffbeb; color: #92400e;">
        ⚠️ {{ context.ecommerce_section.incomplete_note }}：以下为已上传部分的数据，不做环比对比。
      </div>
      {% endif %}
      <!-- Total Overview KPI -->
      <div class="kpi-grid">
        <div class="kpi-card" style="background: #f0fdf4; border-color: #bbf7d0;">
          <div class="kpi-label" style="color: #166534;">本周全商城 GMV</div>
          <div class="kpi-value" style="color: #15803d;">¥{{ context.ecommerce_section.this_week_total.gmv | fmt_num }}</div>
          {% if ecom_complete %}{{ render_delta(context.ecommerce_section.this_week_total.gmv, context.ecommerce_section.last_week_total.gmv, true, '¥') }}{% endif %}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">本周总订单数</div>
          <div class="kpi-value">{{ context.ecommerce_section.this_week_total.order_count | fmt_int }}</div>
          {% if ecom_complete %}{{ render_delta(context.ecommerce_section.this_week_total.order_count, context.ecommerce_section.last_week_total.order_count) }}{% endif %}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">下单客户数</div>
          <div class="kpi-value">{{ context.ecommerce_section.this_week_total.customers | fmt_int }}</div>
          {% if ecom_complete %}{{ render_delta(context.ecommerce_section.this_week_total.customers, context.ecommerce_section.last_week_total.customers) }}{% endif %}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">客单价</div>
          <div class="kpi-value">{% if context.ecommerce_section.this_week_total.aov is not none %}¥{{ context.ecommerce_section.this_week_total.aov | fmt_num }}{% else %}—{% endif %}</div>
          {% if ecom_complete %}{{ render_delta(context.ecommerce_section.this_week_total.aov, context.ecommerce_section.last_week_total.aov, true, '¥') }}{% endif %}
        </div>
        <div class="kpi-card">
          <div class="kpi-label">动销 SKU 种类</div>
          <div class="kpi-value">{{ context.ecommerce_section.this_week_total.sku_count | fmt_int }}</div>
          {% if ecom_complete %}{{ render_delta(context.ecommerce_section.this_week_total.sku_count, context.ecommerce_section.last_week_total.sku_count) }}{% endif %}
        </div>
      </div>
      {% if context.ecommerce_section.daily %}
      <div class="dim" style="display:flex; align-items:center; gap:10px; margin-top:10px; font-size:12px;">
        本周每日 GMV {{ context.ecommerce_section.daily | sparkline(240, 36) | safe }}
      </div>
      {% endif %}
      {% set st = context.ecommerce_section.status %}
      {% if st %}
      <div class="dim" style="margin-top:8px; font-size:12px; line-height:1.7;">
        未计入 GMV：关闭/取消/未付款/已删除 {{ st.excluded_orders | fmt_int }} 单（¥{{ st.excluded_amount | fmt_num }}）；已扣除退款 ¥{{ st.refunds | fmt_num }}{% if st.unknown_orders %}；状态未知 {{ st.unknown_orders | fmt_int }} 单仍计入{% endif %}。
      </div>
      {% endif %}

      <!-- Platform breakdown cards -->
      <h4 style="margin: 20px 0 10px; color: var(--text-muted);">渠道销售拆解</h4>
      <div class="kpi-grid">
        {% for platform in context.ecommerce_section.platforms %}
        <div class="kpi-card">
          <div class="kpi-label">{{ platform.platform }} 渠道</div>
          <div class="kpi-value">¥{{ platform.this_week.gmv | fmt_num }}</div>
          {% if ecom_complete %}{{ render_delta(platform.this_week.gmv, platform.last_week.gmv, true, '¥') }}{% endif %}
          <div class="dim" style="font-size:11.5px; margin-top:4px;">订单量：{{ platform.this_week.order_count | fmt_int }} 单{% if platform.this_week.customers %} · 客户 {{ platform.this_week.customers | fmt_int }}{% endif %}{% if platform.this_week.aov is not none %} · 客单价 ¥{{ platform.this_week.aov | fmt_num }}{% endif %}</div>
          {% if platform.stale_through %}<div style="font-size:11.5px; margin-top:4px; color:#92400e;">⚠️ 订单仅上传至 {{ platform.stale_through | fmt_date }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>

      <!-- Top SKUs Table & Horizontal Bar Chart -->
      {% if context.ecommerce_section.top_skus %}
      <h4 style="margin: 24px 0 10px; color: var(--text-muted);">🏆 本周热销商品 Top 10（按销售额）</h4>
      <div class="chart-container" style="height: 280px; margin-bottom: 16px;">
        <canvas id="chartTopSkus"></canvas>
      </div>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th style="width: 50px;">排名</th>
              <th>商品名称 / SKU</th>
              <th class="num">数量*</th>
              <th class="num">销售额 (GMV)</th>
            </tr>
          </thead>
          <tbody>
            {% for sku in context.ecommerce_section.top_skus %}
            <tr>
              <td>
                {% if loop.index == 1 %}<span class="rank-pill rank-1">1</span>
                {% elif loop.index == 2 %}<span class="rank-pill rank-2">2</span>
                {% elif loop.index == 3 %}<span class="rank-pill rank-3">3</span>
                {% else %}<span class="dim" style="padding-left:6px;">{{ loop.index }}</span>
                {% endif %}
              </td>
              <td class="title">{{ sku.sku }}</td>
              <td class="num">{{ sku.quantity | fmt_int }}</td>
              <td class="num" style="font-weight: 700;">¥{{ sku.gmv | fmt_num }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      <!-- Top Provinces Table -->
      {% if context.ecommerce_section.top_provinces %}
      <h4 style="margin: 24px 0 10px; color: var(--text-muted);">📍 本周订单省份分布 Top 5</h4>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th style="width: 50px;">排名</th>
              <th>省份</th>
              <th class="num">订单数</th>
              <th class="num">销售额 (GMV)</th>
            </tr>
          </thead>
          <tbody>
            {% for prov in context.ecommerce_section.top_provinces %}
            <tr>
              <td>
                {% if loop.index == 1 %}<span class="rank-pill rank-1">1</span>
                {% elif loop.index == 2 %}<span class="rank-pill rank-2">2</span>
                {% elif loop.index == 3 %}<span class="rank-pill rank-3">3</span>
                {% else %}<span class="dim" style="padding-left:6px;">{{ loop.index }}</span>
                {% endif %}
              </td>
              <td style="font-weight: 600;">{{ prov.province }}</td>
              <td class="num">{{ prov.order_count | fmt_int }} 单</td>
              <td class="num">¥{{ prov.gmv | fmt_num }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      <div class="caveat-box">ℹ️ *数量：有赞导出只有「商品种类数」，京东/天猫为订购数量，合计不等于售出件数。商城数据汇总自有赞、京东、天猫导出的订单。自 2026 年 10 月起，GMV 与订单数不含已关闭、已取消、未付款和京东已删除订单，有赞订单已扣除退款；此前推送的周报未重算。</div>
    </div>
  </section>
  {% endif %}

  <footer>
    自媒体与商城全平台数据自动化报告 · OmniPanel
  </footer>
</div>

<script>
// Tab switcher logic
function switchPanel(panelId, btnElement) {
  const tabs = document.querySelectorAll('.nav-tab');
  tabs.forEach(t => t.classList.remove('active'));
  btnElement.classList.add('active');

  const panels = document.querySelectorAll('.platform-panel');
  if (panelId === 'all') {
    panels.forEach(p => p.style.display = 'block');
  } else {
    panels.forEach(p => {
      if (p.id === 'panel-' + panelId) {
        p.style.display = 'block';
      } else {
        p.style.display = 'none';
      }
    });
  }
}

// Chart.js Visual Graphs Initialization
document.addEventListener("DOMContentLoaded", function() {
  if (typeof Chart === "undefined") return;

  // 1. Platform Traffic Comparison Grouped Bar Chart
  const ctxCompare = document.getElementById('chartPlatformCompare');
  if (ctxCompare) {
    new Chart(ctxCompare, {
      type: 'bar',
      data: {
        labels: ['公众号阅读', '小红书观看', '视频号播放', '知乎阅读', '蒲公英曝光'],
        datasets: [
          {
            label: '本周',
            data: [
              {{ context.wechat_reads.this_week if context.wechat_reads and context.wechat_reads.this_week is not none else 'null' }},
              {{ context.xhs_views.this_week if context.xhs_views and context.xhs_views.this_week is not none else 'null' }},
              {{ context.channels_plays.this_week if context.channels_plays and context.channels_plays.this_week is not none else 'null' }},
              {{ context.zhihu_section.this_week_summary.total_reads if context.zhihu_section else 'null' }},
              {{ context.pgy_impressions.this_week if context.pgy_impressions and context.pgy_impressions.this_week is not none else 'null' }}
            ],
            backgroundColor: '#3b82f6',
            borderRadius: 6
          },
          {
            label: '上周',
            data: [
              {{ context.wechat_reads.last_week if context.wechat_reads and context.wechat_reads.last_week is not none else 'null' }},
              {{ context.xhs_views.last_week if context.xhs_views and context.xhs_views.last_week is not none else 'null' }},
              {{ context.channels_plays.last_week if context.channels_plays and context.channels_plays.last_week is not none else 'null' }},
              {{ context.zhihu_section.last_week_summary.total_reads if context.zhihu_section else 'null' }},
              {{ context.pgy_impressions.last_week if context.pgy_impressions and context.pgy_impressions.last_week is not none else 'null' }}
            ],
            backgroundColor: '#cbd5e1',
            borderRadius: 6
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'top' },
          tooltip: { mode: 'index', intersect: false }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
          x: { grid: { display: false } }
        }
      }
    });
  }

  // 2. E-commerce GMV Donut Chart
  const ctxEcom = document.getElementById('chartEcomDonut');
  if (ctxEcom) {
    new Chart(ctxEcom, {
      type: 'doughnut',
      data: {
        labels: [{% if context.ecommerce_section %}{% for p in context.ecommerce_section.platforms %}{{ p.platform | tojson }},{% endfor %}{% endif %}],
        datasets: [{
          data: [{% if context.ecommerce_section %}{% for p in context.ecommerce_section.platforms %}{{ p.this_week.gmv }},{% endfor %}{% endif %}],
          backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#ec4899'],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'right' }
        },
        cutout: '65%'
      }
    });
  }

  // 3. Top SKUs Horizontal Bar Chart
  const ctxSkus = document.getElementById('chartTopSkus');
  if (ctxSkus) {
    new Chart(ctxSkus, {
      type: 'bar',
      data: {
        labels: [{% if context.ecommerce_section %}{% for sku in context.ecommerce_section.top_skus %}{{ sku.sku[:12] | tojson }},{% endfor %}{% endif %}],
        datasets: [{
          label: '销售额 (¥)',
          data: [{% if context.ecommerce_section %}{% for sku in context.ecommerce_section.top_skus %}{{ sku.gmv }},{% endfor %}{% endif %}],
          backgroundColor: '#10b981',
          borderRadius: 6
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: { beginAtZero: true, grid: { color: '#f1f5f9' } },
          y: { grid: { display: false } }
        }
      }
    });
  }
});
</script>

</body>
</html>
