        </div>
        {% endif %}
        <div class="kpi-card">
          <div class="kpi-label">笔记互动（赞/评/藏/分享）</div>
          <div class="kpi-value">{{ section.this_week_summary.total_interactions | fmt_int }}</div>
          {{ render_cohort_ref(section.last_week_summary.total_interactions) }}
        </div>
      </div>

      <!-- Top Follower-gaining notes -->
      {% if section.top_follower_sources %}
